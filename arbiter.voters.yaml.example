# Copy to arbiter.voters.yaml (or set ARBITER_VOTERS_PATH).
# Explicit provider/model pairs — one OpenAI-compatible adapter for all three.
# Voter ids MUST match voters[] passed to open_decision.

voters:
  - id: voter-1
    base_url: https://api.openai.com/v1
    model: gpt-4o-mini
    api_key_env: ARBITER_VOTER_1_KEY
    temperature: 0
    max_tokens: 1200
    timeout_seconds: 45
  - id: voter-2
    base_url: https://openrouter.ai/api/v1
    model: anthropic/claude-sonnet-4
    api_key_env: ARBITER_VOTER_2_KEY
    temperature: 0
    max_tokens: 1200
    timeout_seconds: 45
  - id: voter-3
    base_url: https://generativelanguage.googleapis.com/v1beta/openai
    model: gemini-2.0-flash
    api_key_env: ARBITER_VOTER_3_KEY
    temperature: 0
    max_tokens: 1200
    timeout_seconds: 45

round_deadline_seconds: 60
reveal_round: true

# Shadow evaluation: quorum still runs; calls are not gated when true.
# Also set ARBITER_SHADOW_MODE=1. Every decision.opened records mode=shadow|enforce.
shadow_mode: false

# Single-model reference line (must be one of the three ids above). Same blind
# bundle/options as round 1; recorded as baseline.verdict — never mixed into quorum.
baseline_voter: voter-1
