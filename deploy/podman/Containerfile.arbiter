# Arbiter HTTP MCP — discovered by Hangar via mcp.hangar.* labels.
FROM docker.io/library/python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY arbiter ./arbiter
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir .

ENV ARBITER_HTTP_MCP_PATH=/
ENV ARBITER_ALLOW_INSECURE_HTTP=1
EXPOSE 8765

# Path "/" matches Hangar docker discovery (endpoint = http://host:port).
# Insecure HTTP is intentional on the private compose network; Hangar discovery
# cannot attach X-Arbiter-Secret auth from labels alone.
CMD ["arbiter", "serve", "--transport", "http", "--host", "0.0.0.0", "--port", "8765", "--mcp-path", "/"]
