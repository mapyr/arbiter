# Arbiter HTTP MCP — Hangar calls this as a static remote with X-Arbiter-Secret.
FROM docker.io/library/python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY arbiter ./arbiter
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir .

ENV ARBITER_HTTP_MCP_PATH=/
EXPOSE 8765

CMD ["arbiter", "serve", "--transport", "http", "--host", "0.0.0.0", "--port", "8765", "--mcp-path", "/"]
